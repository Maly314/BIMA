{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "build/**/*.ts",
    "next.config.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules.incomplete",
    "dist",
    "pose-research",
    "synthetic-data",
    "analysis",
    "handoff",
    ".tools",
    "db",
    "worker",
    "examples"
  ]
}
