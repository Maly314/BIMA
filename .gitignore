# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules.incomplete/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
dev.stdout.log
dev.stderr.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/.tools/

# local editor/agent state
/.claude/
/.timeline-render-profile/

# Python caches
__pycache__/
*.py[cod]
/.sam31-venv/
/local-models/sam3/

# downloaded datasets and generated experiment output
/pose-research/data/
/pose-research/runs/
/synthetic-data/100hz/
/synthetic-data/10hz_legacy/

# Teensy/Arduino compiler output
/handoff/**/build-cli*/
/handoff/**/build/

# locally captured clinical/research sessions
/recordings/
/captures/
*.webm
*.mp4
*.mov
*.avi
